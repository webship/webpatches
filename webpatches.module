<?php

/**
 * @file
 * Provides additional local patching functionality for websites.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function webpatches_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.webpatches':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Web Patches shows the patches and the ignored patches declared for this site. Patches are applied by Composer, through cweagans/composer-patches and the webship/patches Composer plugin. This module reads the same declarations and applies the same allowlist and ignore rules, so you can see what is declared and what is filtered out.') . '</p>';
      $output .= '<h3>' . t('Uses') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Reviewing the patches of a site') . '</dt>';
      $output .= '<dd>' . t('The report at Reports &gt; Web Patches lists every declared patch with the package it applies to and the source it was declared in, followed by the patches that are declared but not applied.') . '</dd>';
      $output .= '<dt>' . t('Choosing the sources') . '</dt>';
      $output .= '<dd>' . t('Configuration &gt; Development &gt; Web Patches selects which declarations are read: the root composer.json, the patches file referenced by extra.patches-file, a custom patches file, and the patches contributed by installed dependency packages.') . '</dd>';
      $output .= '</dl>';
      return $output;
  }
}
